# Copy to .env.local and fill in. Nothing here is a real secret.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spendwise"

# Session signing key. Generate one with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Optional: without these the app still runs; the matching feature shows a friendly fallback.
GROQ_API_KEY=""          # Penny (assistant), voice commands, receipt reading, AI notes
RESEND_API_KEY=""        # budget alert emails
CALENDARIFIC_API_KEY=""  # holiday-aware notes
CRON_SECRET=""           # protects /api/cron/budget-check
